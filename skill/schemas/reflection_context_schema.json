{
  "type": "object",
  "required": [
    "weekly_theme",
    "mindset_shifts",
    "cross_content_patterns",
    "professional_actions"
  ],
  "properties": {
    "weekly_theme": {
      "type": "object",
      "required": ["category", "theme"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 }
      }
    },
    "mindset_shifts": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["before", "after", "evidence", "confidence"],
        "additionalProperties": false,
        "properties": {
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "supporting_concept"],
              "additionalProperties": false,
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "supporting_concept": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "cross_content_patterns": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "professional_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
