{
  "type": "object",
  "required": [
    "week",
    "executive_summary",
    "knowledge_insights",
    "expression_upgrade",
    "vocabulary_memory",
    "career_reflection",
    "next_learning_direction"
  ],
  "properties": {
    "week": { "type": "string" },
    "executive_summary": {
      "type": "object",
      "required": ["overview", "takeaway"],
      "properties": {
        "overview": { "type": "string" },
        "takeaway": { "type": "string" },
        "highlights": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "knowledge_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what_happened",
          "why_it_matters",
          "my_interpretation",
          "application"
        ],
        "properties": {
          "what_happened": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "my_interpretation": { "type": "string" },
          "application": { "type": "string" }
        }
      }
    },
    "expression_upgrade": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression", "meaning", "context", "example"],
        "properties": {
          "expression": { "type": "string" },
          "meaning": { "type": "string" },
          "context": { "type": "string" },
          "example": { "type": "string" }
        }
      }
    },
    "vocabulary_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "word",
          "context",
          "meaning",
          "professional_category",
          "my_usage",
          "review_status"
        ],
        "properties": {
          "word": { "type": "string" },
          "context": { "type": "string" },
          "meaning": { "type": "string" },
          "professional_category": { "type": "string" },
          "my_usage": { "type": "string" },
          "review_status": { "type": "string" }
        }
      }
    },
    "career_reflection": {
      "type": "object",
      "required": ["questions", "possible_applications"],
      "properties": {
        "questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "possible_applications": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "next_learning_direction": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
