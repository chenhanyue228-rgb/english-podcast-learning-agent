{
  "type": "object",
  "required": [
    "week",
    "podcast_summary",
    "key_topics",
    "expression_review",
    "category_distribution",
    "learning_insights",
    "vocabulary_memory",
    "next_week_plan"
  ],
  "properties": {
    "week": { "type": "string" },
    "podcast_summary": {
      "type": "object",
      "required": ["english", "chinese"],
      "properties": {
        "english": { "type": "string" },
        "chinese": { "type": "string" }
      }
    },
    "key_topics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expression_review": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "expression",
          "category",
          "meaning",
          "original_context",
          "learning_note",
          "review_priority"
        ],
        "properties": {
          "expression": { "type": "string" },
          "category": { "type": "string" },
          "meaning": { "type": "string" },
          "original_context": { "type": "string" },
          "learning_note": { "type": "string" },
          "review_priority": { "type": "integer" }
        }
      }
    },
    "category_distribution": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "learning_insights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["insight", "evidence", "why_it_matters"],
        "properties": {
          "insight": { "type": "string" },
          "evidence": { "type": "string" },
          "why_it_matters": { "type": "string" }
        }
      }
    },
    "vocabulary_memory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "word",
          "context",
          "meaning",
          "professional_category",
          "my_usage",
          "review_status"
        ],
        "properties": {
          "word": { "type": "string" },
          "context": { "type": "string" },
          "meaning": { "type": "string" },
          "professional_category": { "type": "string" },
          "my_usage": { "type": "string" },
          "review_status": { "type": "string" }
        }
      }
    },
    "next_week_plan": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
