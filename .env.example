NOTION_TOKEN=
NOTION_PODCAST_LIBRARY_DATABASE_ID=
NOTION_EXPRESSION_DATABASE_ID=
NOTION_VOCABULARY_DATABASE_ID=
NOTION_WEEKLY_REFLECTION_DATABASE_ID=

# Legacy compatibility name for an existing Weekly Review database.
# NOTION_WEEKLY_REVIEW_DATABASE_ID=

# Optional for setup if passed as --parent-page-id.
# Accepts either a raw Notion page ID or a copied Notion page URL.
NOTION_PARENT_PAGE_ID=

# Required write-safety boundary. Every production writer verifies that all
# four configured data sources belong directly to this parent page.
NOTION_TARGET_PARENT_PAGE_ID=

# Application runtime settings.
EPLA_ENV=development
EPLA_LOG_LEVEL=INFO
EPLA_DATA_DIR=data
EPLA_AUDIO_OUTPUT_DIR=data/audio
EPLA_TRANSCRIPT_OUTPUT_DIR=data/transcripts

# Pure Codex Skill production runtime. No OPENAI_API_KEY is required.
ENRICHMENT_PROVIDER=codex
WEEKLY_REFLECTION_PROVIDER=codex
WEEKLY_REVIEW_PROVIDER=codex

# Compatibility/testing only: set an individual provider to placeholder or
# openai explicitly. The OpenAI compatibility path is deprecated.
